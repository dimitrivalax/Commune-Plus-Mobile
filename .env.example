# Configuration Supabase
# Obtenez ces valeurs depuis votre projet Supabase : https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Configuration Cloudinary
# Obtenez ces valeurs depuis votre compte Cloudinary : https://cloudinary.com/console
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Instructions :
# 1. Copiez ce fichier vers .env : cp .env.example .env
# 2. Remplissez les valeurs avec vos credentials réels
# 3. Ne commitez jamais le fichier .env dans git (il est déjà dans .gitignore)
