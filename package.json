{
  "name": "Commune Plus",
  "version": "1.2.2",
  "description": "Application mobile Commune Plus - Gestion des signalements, réservations et informations municipales",
  "author": "Dimitri Valax",
  "private": true,
  "scripts": {
    "dev": "vite",
    "prod": "dotenv -e .env -- vite",
    "dev:local": "dotenv -e .env.local -- vite",
    "dev:dev": "dotenv -e .env.dev -- vite",
    "build": "dotenv -e .env -- vite build",
    "build:local": "dotenv -e .env.local -- vite build",
    "preview": "vite preview",
    "lint": "eslint src e2e *.js --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "assets:generate": "capacitor-assets generate --assetPath public/assets --iconBackgroundColor '#ffffff' --splashBackgroundColor '#ffffff'",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@capacitor-firebase/crashlytics": "^8.2.0",
    "@capacitor-firebase/messaging": "^8.1.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.1.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@ionic/vue": "^8.0.0",
    "@ionic/vue-router": "^8.0.0",
    "axios": "^1.6.2",
    "firebase": "^12.10.0",
    "ionicons": "^8.0.0",
    "leaflet": "^1.9.4",
    "posthog-js": "^1.313.0",
    "sharp": "^0.34.5",
    "swiper": "^12.0.3",
    "vue": "^3.3.4",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.1.0",
    "@playwright/test": "^1.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vue/eslint-config-prettier": "^8.0.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^8.53.0",
    "eslint-plugin-vue": "^9.18.1",
    "jimp": "^1.6.0",
    "prettier": "^3.1.0",
    "sass-embedded": "^1.97.3",
    "vite": "^5.0.5"
  },
  "packageManager": "pnpm@10.33.0"
}
